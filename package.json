{
	"name": "@trioforge/random",
	"version": "0.1.0",
	"description": "Seeded, deterministic random numbers for roblox-ts that every client and server draws the same",
	"keywords": [
		"roblox",
		"roblox-ts",
		"random",
		"rng",
		"prng",
		"seed",
		"xoshiro"
	],
	"bugs": "https://github.com/Trio-Forge-Studio/packages/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Trio-Forge-Studio/packages.git",
		"directory": "packages/random"
	},
	"license": "MIT",
	"type": "module",
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"files": [
		"out",
		"!**/*.tsbuildinfo",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rbxtsc --type package",
		"test": "vitest run",
		"lint": "oxlint",
		"fmt": "oxfmt src test vitest.config.ts",
		"typecheck": "tsc -p test",
		"check": "oxfmt --check src test vitest.config.ts && oxlint && tsc -p test && vitest run",
		"prepack": "rbxtsc --type package"
	},
	"devDependencies": {
		"@rbxts/compiler-types": "3.0.0-types.0",
		"@rbxts/types": "^1.0.958",
		"@types/node": "^24.19.2",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"roblox-ts": "^3.0.0",
		"typescript": "5.5.3",
		"vitest": "^5.0.5"
	}
}
