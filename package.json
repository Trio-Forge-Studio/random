{
	"name": "@trioforge/random",
	"version": "0.1.1",
	"description": "Seeded, deterministic random numbers for roblox-ts that every client and server draws the same",
	"keywords": [
		"roblox",
		"roblox-ts",
		"random",
		"rng",
		"prng",
		"seed",
		"xoshiro"
	],
	"homepage": "https://website.trio-forge.workers.dev/docs/random/",
	"bugs": "https://github.com/Trio-Forge-Studio/random/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Trio-Forge-Studio/random.git"
	},
	"license": "MIT",
	"type": "module",
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"files": [
		"out",
		"!**/*.tsbuildinfo",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rbxtsc --type package",
		"test": "vp test",
		"check": "vp check && tsc -p test && vp test",
		"prepack": "rbxtsc --type package",
		"examples": "node tooling/check-examples.mjs --run",
		"fmt": "vp fmt",
		"prepare": "vp config",
		"changeset": "changeset"
	},
	"devDependencies": {
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"@rbxts/compiler-types": "3.0.0-types.0",
		"@rbxts/types": "1.0.959",
		"@types/node": "24.19.2",
		"roblox-ts": "3.0.0",
		"typescript": "5.5.3",
		"vite-plus": "1.3.0"
	},
	"packageManager": "pnpm@12.15.0"
}
