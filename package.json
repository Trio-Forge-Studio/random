{
	"name": "@trioforge/random",
	"version": "0.1.0",
	"description": "Seeded, deterministic random numbers for roblox-ts that every client and server draws the same",
	"keywords": [
		"roblox",
		"roblox-ts",
		"random",
		"rng",
		"prng",
		"seed",
		"xoshiro"
	],
	"bugs": "https://github.com/Trio-Forge-Studio/packages/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Trio-Forge-Studio/packages.git",
		"directory": "packages/random"
	},
	"license": "MIT",
	"type": "module",
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"files": [
		"out",
		"!**/*.tsbuildinfo",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rbxtsc --type package",
		"test": "vp test",
		"check": "tsc -p test && vp test",
		"prepack": "rbxtsc --type package"
	},
	"devDependencies": {
		"@rbxts/compiler-types": "catalog:rbxts",
		"@rbxts/types": "catalog:rbxts",
		"@types/node": "^24.19.2",
		"roblox-ts": "catalog:rbxts",
		"typescript": "catalog:rbxts",
		"vite-plus": "catalog:"
	}
}
